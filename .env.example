NODE_ENV=development

DATABASE_URL=postgresql://surprise:surprise@localhost:5432/surprise_studio

JWT_SECRET=
JWT_REFRESH_SECRET=


STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=surprise-assets
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
# Optional: host that clients (phone/emulator) use to reach storage, e.g. http://10.0.2.2:9000
STORAGE_PUBLIC_ENDPOINT=
# Optional: CDN/public base URL for processed images (defaults to endpoint/bucket)
STORAGE_PUBLIC_URL=

AI_PROVIDER=
AI_API_KEY=

# Web app (apps/web). The server fetches surprises from API_URL (falls back to NEXT_PUBLIC_API_URL).
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
API_URL=
# Public origin of the web app, used for absolute links in social previews
NEXT_PUBLIC_SITE_URL=http://localhost:3000

ANALYTICS_KEY=

PAYMENT_PROVIDER=
PAYMENT_SECRET=
